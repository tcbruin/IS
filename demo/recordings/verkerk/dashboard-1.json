{
  "title": "Crate balance per customer",
  "layout": "openItems",
  "model": {
    "entity": {
      "singular": "Customer",
      "plural": "Customers",
      "count": 93,
      "names": [
        "De Groene Lepel",
        "Brasserie Zeven",
        "Supermarkt Van Dijk",
        "Eetcafé De Haven",
        "Supermarkt Hofstede",
        "Restaurant Amandel",
        "Bistro De Kade",
        "Supermarkt Noordermarkt",
        "Trattoria Sole",
        "Supermarkt De Waal",
        "Lunchroom Vork",
        "Supermarkt Oostpoort"
      ],
      "sizeSpread": "skewed"
    },
    "dimensions": [
      {
        "key": "segment",
        "label": "Segment",
        "values": [
          "Restaurants",
          "Supermarkets"
        ]
      }
    ],
    "period": {
      "grain": "week",
      "count": 16
    },
    "measures": [
      {
        "key": "delivered",
        "label": "Crates delivered",
        "unit": "count",
        "higherIsBetter": true,
        "typical": 120,
        "spread": "high",
        "trend": "flat"
      },
      {
        "key": "returned",
        "label": "Crates returned",
        "unit": "count",
        "higherIsBetter": true,
        "spread": "medium",
        "trend": "flat",
        "relativeTo": {
          "measure": "delivered",
          "min": 0.75,
          "max": 1
        }
      }
    ],
    "derived": [
      {
        "key": "crates_outstanding",
        "label": "Crates outstanding",
        "unit": "count",
        "higherIsBetter": false,
        "op": "balance",
        "a": "delivered",
        "b": "returned"
      },
      {
        "key": "crates_week_change",
        "label": "Change vs last week",
        "unit": "count",
        "higherIsBetter": false,
        "op": "subtract",
        "a": "delivered",
        "b": "returned"
      },
      {
        "key": "crates_value",
        "label": "Replacement value",
        "unit": "euro",
        "higherIsBetter": false,
        "op": "multiply",
        "a": "crates_outstanding",
        "factor": 9
      }
    ]
  },
  "anchors": [
    {
      "kind": "count",
      "value": 93,
      "quote": "spread across ninety-three customers in total"
    },
    {
      "kind": "level",
      "measure": "crates_outstanding",
      "value": 1800,
      "quote": "we had about 1800 crates outstanding with customers"
    }
  ],
  "kpis": [
    {
      "measure": "crates_outstanding",
      "label": "Crates outstanding",
      "show": "value"
    },
    {
      "measure": "crates_value",
      "label": "Replacement value",
      "show": "value"
    }
  ],
  "visuals": [
    {
      "type": "table",
      "title": "Crate balance per customer",
      "rows": "entity",
      "columns": [
        "crates_outstanding",
        "crates_week_change",
        "crates_value"
      ],
      "flag": {
        "measure": "crates_week_change",
        "rule": "vsPrevious"
      },
      "sortBy": "crates_outstanding",
      "sortDir": "desc"
    },
    {
      "type": "chart",
      "title": "Crates outstanding per week",
      "x": "period",
      "series": [
        {
          "measure": "delivered",
          "style": "bar",
          "running": false
        },
        {
          "measure": "returned",
          "style": "bar",
          "running": false
        },
        {
          "measure": "crates_week_change",
          "style": "line",
          "running": true
        }
      ]
    },
    {
      "type": "chart",
      "title": "Crates outstanding per segment",
      "x": "segment",
      "series": [
        {
          "measure": "crates_outstanding",
          "style": "bar",
          "running": false
        }
      ]
    }
  ],
  "filters": [
    "segment",
    "entity"
  ]
}