# --- Option A: DeepSeek (default) ---
# API key, required unless you switch to a local model below. Get one at https://platform.deepseek.com
LLM_API_KEY=

# Optional overrides. Defaults shown below.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- Option B: local model via Ollama (e.g. Qwen3 4B) ---
# 1. Install Ollama (https://ollama.com), then run: ollama pull qwen3:4b
# 2. Uncomment these three lines (LLM_API_KEY above can be any non-empty value, Ollama ignores it):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=ollama

# Language the AI writes proposals and dashboards in (nl or en). Defaults to nl.
# LLM_OUTPUT_LANGUAGE=nl
